# App
APP_ENV=local
APP_PORT=8000
LOG_LEVEL=INFO

# Go internal API
GO_SERVICE_URL=http://localhost:8080
SERVICE_TOKEN=change-me-service-token

# MinIO
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=tenders
MINIO_USE_SSL=false

# Redis (Celery broker + result backend)
REDIS_URL=redis://localhost:6379/0

# PostgreSQL (direct access for AI/ML tables only)
DATABASE_URL=postgresql+asyncpg://kpi:kpi_secret@localhost:5432/kpi_tenders

# Gemini
GEMINI_API_KEY=
GEMINI_LIGHT_MODEL=gemini-2.0-flash
GEMINI_HEAVY_MODEL=gemini-2.5-pro
